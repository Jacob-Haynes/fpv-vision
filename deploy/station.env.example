# Example ~/.config/isr-kit/station.env for the Drone-ops Mac (isr-droneops.local).
# The platform's laptop/start-mac.sh sources this, then runs scripts/run-laptop.sh.
# Never commit the real file (it holds MQTT_PASS / GEMINI_API_KEY).
TAK_HOST=isr-pi.local
TAK_PORT=8087
MQTT_HOST=isr-pi.local
MQTT_PORT=1883
MQTT_USER=isrkit
MQTT_PASS=change-me
VLM_URL=http://isr-hq.local:11434
VLM_MODEL=qwen3-vl:8b
# GEMINI_API_KEY=            # optional cloud fallback; sends snapshots to Google (demo footage only)
# FPV_FOOTAGE_DIRS=$HOME/Movies/FPV
# FPV_SOURCE=replay:$HOME/Movies/FPV
# FPV_DEFAULT_POSITION=30U WB 87427 67248
