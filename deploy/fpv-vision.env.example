# /etc/fpv-vision.env — copied here by install.sh if missing. Never commit the real file.

# --- video source -----------------------------------------------------------
# auto            first USB capture device if present, otherwise the simulate clip
# simulate        public-domain sample clip (simulate:aerial for the NASA drone clip)
# uvc:/dev/video0 USB UVC capture card (FPV receiver / goggles HDMI-out / GoPro HDMI)
# rtsp://host:8554/live  rtmp://...  http://...  udp://@:5600   network streams
# file:/var/lib/fpv-vision/clips/some.mp4
# gopro-usb       GoPro HERO9+ in USB webcam mode (see README)
FPV_SOURCE=auto
FPV_CAPTURE_WIDTH=1280
FPV_CAPTURE_HEIGHT=720

# --- detection --------------------------------------------------------------
# install.sh exports yolo26n to NCNN at 416 px into /var/lib/fpv-vision/models
FPV_MODEL=yolo26n
FPV_IMGSZ=416
FPV_CONF=0.30
# 1 = all 80 COCO classes; 0 = people, vehicles, boats, aircraft only
FPV_ALL_CLASSES=0
# max overlay/stream frame rate; detector backs off if this can't be held
FPV_TARGET_FPS=20
FPV_STREAM_WIDTH=960
FPV_MAX_CLIP_SECONDS=300

# --- spot reports -----------------------------------------------------------
FPV_CALLSIGN=FPV-VISION
# pre-fills the UI: MGRS grid or "lat, lon" of the observation post / area of interest
FPV_DEFAULT_POSITION=
TAK_HOST=127.0.0.1
TAK_PORT=8087
TAK_ENABLED=1
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest
MESH_ENABLED=1

# --- Gemini (optional cloud mode) -------------------------------------------
# Leave empty for fully offline operation. When set, snapshots are SENT TO GOOGLE:
# use demo footage only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MIN_INTERVAL=10
# 0 = off; otherwise auto-summary period in seconds (also adjustable in the UI)
GEMINI_PERIODIC_SECONDS=0
