# /etc/fpv-vision.env — copied here by install.sh if missing. Never commit the real file.

# --- video source -----------------------------------------------------------
# auto            first USB capture device if present, otherwise the simulate clip
# simulate        public-domain sample clip (simulate:aerial for the NASA drone clip)
# uvc:/dev/video0 USB UVC capture card (FPV receiver / goggles HDMI-out / GoPro HDMI)
# rtsp://host:8554/live  rtmp://...  http://...  udp://@:5600   network streams
# replay:/var/lib/fpv-vision/footage   recorded footage replayed as live (file, folder or a|b list)
# gopro-usb       GoPro HERO9+ in USB webcam mode (see README)
FPV_SOURCE=auto
FPV_CAPTURE_WIDTH=1280
FPV_CAPTURE_HEIGHT=720

# --- detection --------------------------------------------------------------
# auto = YOLO26s @640 on a GPU (CUDA/Apple MPS), YOLO26n @416 on CPU (the Pi).
# install.sh exports the CPU model to NCNN into /var/lib/fpv-vision/models.
FPV_MODEL=auto
FPV_CPU_MODEL=yolo26n
FPV_CPU_IMGSZ=416
FPV_DEVICE=cpu
FPV_CONF=0.30
# 1 = all 80 COCO classes; 0 = people, vehicles, boats, aircraft only
FPV_ALL_CLASSES=0
# max overlay/stream frame rate; detector backs off if this can't be held
FPV_TARGET_FPS=20
FPV_STREAM_WIDTH=960
FPV_MAX_CLIP_SECONDS=300

# --- spot reports -----------------------------------------------------------
FPV_CALLSIGN=FPV-VISION
# pre-fills the UI: MGRS grid or "lat, lon" of the observation post / area of interest
FPV_DEFAULT_POSITION=
# On the Pi everything is local. (On a Mac use isr-pi.local and MQTT user isrkit: see README.)
TAK_HOST=127.0.0.1
TAK_PORT=8087
TAK_ENABLED=1
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest
MESH_ENABLED=1
# heartbeat to isrkit/heartbeat/fpv-vision every 10 s needs MQTT; host/url default to <hostname>.local
FPV_PUBLIC_HOST=

# --- scene description ------------------------------------------------------
# auto: openai_compat if VLM_URL is set, else gemini if GEMINI_API_KEY is set, else off.
# Fallback when unreachable: openai_compat -> gemini (if key) -> off (local detector summary).
VLM_BACKEND=auto
# Bare Ollama base URL on the HQ Mac (no path), e.g. http://isr-hq.local:11434
VLM_URL=
VLM_MODEL=qwen3-vl:8b
VLM_MIN_INTERVAL=3

# --- Gemini (optional cloud mode) -------------------------------------------
# Leave empty for fully offline operation. When set, snapshots are SENT TO GOOGLE:
# use demo footage only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MIN_INTERVAL=10
# 0 = off; otherwise auto-summary period in seconds for whichever backend is active
GEMINI_PERIODIC_SECONDS=0
